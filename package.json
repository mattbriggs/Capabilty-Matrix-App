{
  "name": "capability-ownership-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && node scripts/prepare-sites-build.mjs",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "npm run test:js && npm run test:py && npm run test:rust",
    "test:js": "node --test tests/js/*.test.mjs",
    "test:js:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/domain/**' --test-coverage-include='src/storage/**' --test-coverage-include='src/state/projectService.js' --test-coverage-include='src/features/map/*.js' --test-coverage-exclude='src/features/map/useLayoutRunner.js' --test-coverage-exclude='src/features/map/layout.worker.js' --test-coverage-lines=95 --test-coverage-branches=90 tests/js/*.test.mjs",
    "test:py": "${PYTHON:-.venv/bin/python} -m pytest",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "schema": "cd sidecar && ${PYTHON:-../.venv/bin/python} -m capmatrix.schema_export --write",
    "tauri": "tauri",
    "sidecar:build": "bash scripts/build-sidecar.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "^12.12.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
