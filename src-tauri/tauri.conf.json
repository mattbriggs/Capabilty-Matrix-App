{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capability and Ownership Matrix",
  "version": "0.1.0",
  "identifier": "com.capabilityownership.matrix",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 4173 --strictPort",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Capability and Ownership Matrix", "width": 1440, "height": 1024, "minWidth": 900, "minHeight": 700 }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/capability-sidecar"]
  }
}
